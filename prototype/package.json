{
  "name": "squading-renderer-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview:pages": "node scripts/serve-pages.mjs",
    "preview": "vite preview",
    "benchmark": "mkdir -p artifacts && node scripts/benchmark.mjs --local --output artifacts/benchmark-local.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/three": "0.185.4",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
